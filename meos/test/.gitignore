# Smoke-test sources generated by gen_smoketest.py at run time. Both meos.yml and
# run_smoketests.sh regenerate them from the installed headers before use, so none
# of them is tracked.
/trgeometry_test.c
/tpose_smoketest.c
/tcbuffer_smoketest.c
/tnpoint_smoketest.c
/tgeometry_smoketest.c
/tjsonb_smoketest.c

# Compiled smoke-test binaries and valgrind logs
/build/
__pycache__/

# Corpora harvested from the GEOS test suite by geos_harvest.py and
# relate_harvest_geos.py. The WKT they carry is the GEOS project's test data
# under the LGPL 2.1, so they are generated on demand rather than tracked.
/buffer_corpus_geos.txt
/convexhull_corpus_geos.txt
/issimple_corpus_geos.txt
/relate_corpus_geos.txt
